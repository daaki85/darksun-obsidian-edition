*.bat text eol=crlf

# Left out of the release zip (git archive, .github/workflows/release.yml): the developers' pages,
# the tests, the developers' picture of the Loader, the developers' tool that drafts the quest
# table (nothing the Loader runs imports it), and git's own two files. They stay in the
# repository, where the links to them go by their GitHub address: the manual's at the release's
# tag, the Markdown pages' at main. The class outfits' galleries (docs/class-outfits: 130 MB of
# animated reviews) are for the repository's readers only.
/DEVELOPMENT*.md export-ignore
/tests export-ignore
docs/viewer.png export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/dsloader/questdraft.py export-ignore
/docs/class-outfits export-ignore
